        <mxCell id="throughput" parent="1" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=9;" value="Peak load: 50 drones × 4 pkt/s = 200 req/s&lt;br&gt;Redis handles 1,500+ req/s — sufficient headroom (NFR04)" vertex="1">
