        <mxCell id="e56" edge="1" parent="1" source="n_redis" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=9;dashed=1;dashPattern=5 3;" target="n_ts" value="Async write-behind&lt;br&gt;(background worker)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note_offline" parent="1" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" value="&lt;b&gt;NFR06 — Offline mode:&lt;/b&gt;&lt;br&gt;If 4G drops, data queued in SQLite. Auto-sync on reconnect within ≤30 s." vertex="1">
          <mxGeometry height="60" width="170" x="60" y="460" as="geometry" />
        </mxCell>
        <mxCell id="note_redis" parent="1" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Why Redis buffer? (NFR04)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Direct DB write at 200 req/s&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;causes I/O bottleneck. Redis&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;decouples ingestion from storage.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="52.5" width="220" x="680" y="457.5" as="geometry" />
        </mxCell>
        <mxCell id="note_compliance" parent="1" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" value="&lt;b&gt;Decree 288/2025/NĐ-CP:&lt;/b&gt;&lt;br&gt;flight_logs + drone_positions retained ≥ 5 years for BvTV audit trail." vertex="1">
          <mxGeometry height="50" width="190" x="940" y="460" as="geometry" />
        </mxCell>
        <mxCell id="e_note_pilot" edge="1" parent="1" source="note_offline" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#82b366;fontSize=9;dashed=1;dashPattern=3 3;opacity=50;" target="n_pilot">
