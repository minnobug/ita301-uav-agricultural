        </mxCell>
        <mxCell id="n_ts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" value="⑥ TimescaleDB 2.x&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;Time-series hypertable&lt;br&gt;5-yr retention (Decree 288)&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="160" x="950" y="340" as="geometry" />
