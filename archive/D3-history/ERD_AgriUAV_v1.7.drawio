        <mxCell id="legend" parent="1" style="text;html=1;strokeColor=#999999;fillColor=#fafafa;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=10;" value="LEGEND&#10;Green row = Primary Key (PK)  |  Orange row = Foreign Key (FK)&#10;Header colors group entities by domain: Blue = Identity &amp; Org | Green = Field &amp; Agronomy |&#10;Orange = Fleet &amp; Safety | Yellow = Operations (core) | Purple = Compliance &amp; Comms |&#10;Gray dashed = derived/operational table | Red/pink = junction table (M:N resolver)&#10;&#10;CARDINALITY NOTATION: each relationship line carries two small labels, one at each end,&#10;written as (min , max):&#10;  1,1 = exactly one (mandatory)        0,1 = zero or one (optional)&#10;  1,n = one or many (mandatory many)   0,n = zero or many (optional many)&#10;Example:  users --1,1-----------0,n-- spray_orders  reads as&#10;'one user places zero-to-many orders; each order belongs to exactly one user.'" vertex="1">
          <mxGeometry height="220" width="760" x="60" y="2120" as="geometry" />
        </mxCell>

